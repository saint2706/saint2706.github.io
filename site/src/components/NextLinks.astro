---
interface LinkItem {
  href: string;
  label: string;
  spaceNum?: string;
  sub?: string;
}

interface Props {
  eyebrow?: string;
  links: LinkItem[];
}

const { eyebrow = 'Other spaces', links } = Astro.props;
---

<nav class="next" aria-label="Other spaces">
  <div class="next-inner">
    <div class="next-header">
      <span class="next-eyebrow">{eyebrow}</span>
    </div>
    <ul class="next-grid">
      {
        links.map(l => (
          <li class="next-item">
            <a href={l.href} class="next-card">
              <div class="next-card-top">
                {l.spaceNum && <span class="next-num">{l.spaceNum}</span>}
                <span class="next-arrow" aria-hidden="true">
                  →
                </span>
              </div>
              <span class="next-label">{l.label}</span>
              {l.sub && <p class="next-sub">{l.sub}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .next {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-rule);
  }

  .next-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .next-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .next-eyebrow {
    font: 0.75rem / 1 var(--font-mono);
    color: var(--color-ink-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .next-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-4);
  }

  .next-item {
    display: flex;
  }

  .next-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    min-height: 84px;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-ink);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  .next-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .next-num {
    font: 0.75rem / 1 var(--font-mono);
    color: var(--color-accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .next-arrow {
    font-size: 1.125rem;
    color: var(--color-accent);
    transition: transform 0.2s var(--ease-out);
  }

  .next-label {
    font: 1.125rem / 1.3 var(--font-display);
    color: var(--color-ink);
    font-weight: 400;
  }

  .next-sub {
    margin: 6px 0 0;
    font: 0.8125rem / 1.45 var(--font-body);
    color: var(--color-ink-2);
  }

  .next-card:hover {
    border-color: var(--color-accent);
    box-shadow:
      0 6px 20px -4px rgba(0, 0, 0, 0.35),
      0 0 0 1px var(--color-accent);
  }

  .next-card:hover .next-arrow {
    transform: translateX(4px);
  }

  html[data-motion='on'] .next-card:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .next-card,
    .next-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

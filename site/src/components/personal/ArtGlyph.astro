---
/**
 * ArtGlyph.astro
 *
 * "The Boundless Cloth" (अक्षय वस्त्र)
 * An interactive Pahari silk & gold zari textile simulation replacing the
 * header mark on the "Art and myth" museum space.
 *
 * Cultural & Mythic Context:
 * Room IV climax: Nainsukh of Guler's "Draupadi Humiliated in the Assembly" (c. 1765).
 * When Dushasana attempts to disrobe Draupadi before the paralyzed Kuru court,
 * divine grace causes her garment to unfold endlessly—an infinite, cascading
 * river of crimson silk and golden zari brocade that no injustice can exhaust.
 *
 * Features:
 * - 160x213px antique Pahari wasli paper folio mount with gold hashiya rules.
 * - Dynamic 6-point Catmull-Rom spline simulating fluid 3D silk cloth folds.
 * - Shimmering gold zari (gota kinari) brocade border with fine embroidery stitching.
 * - Luminous saffron-gold underside lining where the cloth twists in space.
 * - 5 dangling golden hem tassels (jhumkas) that sway with natural pendulum physics.
 * - Interactive cursor wind: moving across the silk creates undulating ripples with spring damping.
 * - Continuous ambient silk breathing wave when idle.
 * - Traditional archival cartouche with Devanagari calligraphy ("अक्षय वस्त्र").
 * - Fully accessible, zero inline style="" attributes (strict CSP compliance).
 */
---

<div
  class="silk-widget"
  id="akshaya-vastra"
  role="img"
  aria-label="Interactive Pahari Silk artwork: The Boundless Cloth from Room IV. Move cursor to create fluid wind ripples in the silk."
>
  <div class="silk-frame">
    <svg
      viewBox="0 0 160 213"
      width="160"
      height="213"
      class="silk-svg"
      aria-hidden="true"
    >
      <defs>
        <!-- Pahari Gold Leaf (Zari) Gradient -->
        <linearGradient id="zari-gold" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#fff5d4" />
          <stop offset="25%" stop-color="#e7b04f" />
          <stop offset="65%" stop-color="#ab7722" />
          <stop offset="100%" stop-color="#6a450c" />
        </linearGradient>

        <!-- Rich Pahari Crimson Silk Gradient -->
        <linearGradient id="silk-crimson" x1="15%" y1="0%" x2="85%" y2="100%">
          <stop offset="0%" stop-color="#e8384f" />
          <stop offset="35%" stop-color="#bd182d" />
          <stop offset="75%" stop-color="#7d0c1b" />
          <stop offset="100%" stop-color="#4e0610" />
        </linearGradient>

        <!-- Saffron Lining Underside Gradient -->
        <linearGradient id="saffron-lining" x1="0%" y1="0%" x2="100%" y2="80%">
          <stop offset="0%" stop-color="#fcd881" />
          <stop offset="40%" stop-color="#e5a435" />
          <stop offset="85%" stop-color="#946313" />
          <stop offset="100%" stop-color="#5a3804" />
        </linearGradient>

        <!-- Sialkoti Wasli Paper Background Gradient -->
        <radialGradient id="wasli-paper" cx="50%" cy="45%" r="70%">
          <stop offset="0%" stop-color="#24102c" />
          <stop offset="60%" stop-color="#16081b" />
          <stop offset="100%" stop-color="#0c040f" />
        </radialGradient>

        <!-- Dynamic Specular Silk Sheen -->
        <linearGradient id="silk-sheen" x1="0%" y1="0%" x2="100%" y2="50%">
          <stop offset="0%" stop-color="rgba(255, 255, 255, 0.45)" />
          <stop offset="50%" stop-color="rgba(253, 226, 160, 0.2)" />
          <stop offset="100%" stop-color="rgba(0, 0, 0, 0)" />
        </linearGradient>
      </defs>

      <!-- Antique Wasli Folio Paper Mount -->
      <rect
        x="3"
        y="3"
        width="154"
        height="207"
        rx="3"
        fill="url(#wasli-paper)"
        stroke="rgba(231, 176, 79, 0.45)"
        stroke-width="1.2"
        class="folio-mount"
      />

      <!-- Pahari Hashiya (Traditional Double Gold Miniature Margin) -->
      <rect
        x="8"
        y="8"
        width="144"
        height="197"
        rx="2"
        fill="none"
        stroke="rgba(231, 176, 79, 0.2)"
        stroke-width="0.8"
      />
      <rect
        x="11"
        y="11"
        width="138"
        height="191"
        rx="1"
        fill="none"
        stroke="rgba(231, 176, 79, 0.12)"
        stroke-width="0.6"
        stroke-dasharray="2 3"
      />

      <!-- Corner Lotus Rosettes (4 Corners) -->
      <g fill="url(#zari-gold)">
        <!-- Top-Left -->
        <circle cx="8" cy="8" r="1.5" />
        <!-- Top-Right -->
        <circle cx="152" cy="8" r="1.5" />
        <!-- Bottom-Left -->
        <circle cx="8" cy="205" r="1.5" />
        <!-- Bottom-Right -->
        <circle cx="152" cy="205" r="1.5" />
      </g>

      <!-- Archival Top Header Tag -->
      <text
        x="80"
        y="21"
        text-anchor="middle"
        class="folio-curatorial-tag"
      >
        NAINSUKH OF GULER · C. 1765
      </text>

      <!-- Ambient Floating Gold Foil Flakes (Swarna Bhasma) -->
      <g class="gold-flakes" fill="url(#zari-gold)" opacity="0.75">
        <polygon points="26,45 28,47 26,49 24,47" class="flake f1" />
        <polygon points="135,38 137,40 135,42 133,40" class="flake f2" />
        <polygon points="20,110 22,112 20,114 18,112" class="flake f3" />
        <polygon points="142,125 144,127 142,129 140,127" class="flake f4" />
        <polygon points="32,160 34,162 32,164 30,162" class="flake f5" />
        <polygon points="132,168 134,170 132,172 130,170" class="flake f6" />
      </g>

      <!-- The Boundless Cloth: Silk River Layers -->
      <g class="silk-river">
        <!-- 1. Underside Golden Twist Folds (Back Layer) -->
        <path
          id="silk-under-1"
          d="M 68,26 C 88,26 122,46 118,58 C 112,66 90,64 74,56 Z"
          fill="url(#saffron-lining)"
          opacity="0.9"
        />
        <path
          id="silk-under-2"
          d="M 44,92 C 54,92 128,122 124,136 C 116,144 88,140 68,128 Z"
          fill="url(#saffron-lining)"
          opacity="0.85"
        />

        <!-- 2. Primary Crimson Silk Body (Front Cascading Wave) -->
        <path
          id="silk-body"
          d="M 62,35 C 70,38 98,42 94,52 C 88,62 32,79 33,92 C 34,105 97,118 98,129 C 99,141 42,154 44,166 C 46,177 75,183 76,188 L 88,192 C 86,186 58,179 56,168 C 54,157 114,142 113,127 C 112,112 47,100 46,88 C 45,76 106,64 108,48 C 109,38 78,28 72,25 Z"
          fill="url(#silk-crimson)"
          class="silk-body-path"
        />

        <!-- 3. Dynamic Specular Silk Sheen Ridge -->
        <path
          id="silk-sheen-path"
          d="M 66,30 C 96,40 40,86 102,126 C 54,162 78,186 78,188"
          fill="none"
          stroke="url(#silk-sheen)"
          stroke-width="3"
          stroke-linecap="round"
          class="sheen-ridge"
        />

        <!-- 4. Gota Kinari / Golden Zari Outer Border -->
        <path
          id="silk-zari-outer"
          d="M 72,25 C 78,28 109,38 108,48 C 106,64 45,76 46,88 C 47,100 112,112 113,127 C 114,142 54,157 56,168 C 58,179 86,186 88,192"
          fill="none"
          stroke="url(#zari-gold)"
          stroke-width="3.5"
          stroke-linecap="round"
          class="zari-outer"
        />
        <!-- Delicate Zari Embroidery Stitch Line -->
        <path
          id="silk-zari-stitch"
          d="M 72,25 C 78,28 109,38 108,48 C 106,64 45,76 46,88 C 47,100 112,112 113,127 C 114,142 54,157 56,168 C 58,179 86,186 88,192"
          fill="none"
          stroke="#fff8e7"
          stroke-width="0.8"
          stroke-dasharray="2 3"
          class="zari-stitch"
        />

        <!-- 5. Dangling Golden Tassels (Jhumkas) at Pallu Hem -->
        <g id="silk-tassels" class="tassels-group">
          <!-- Tassel 1 -->
          <g transform="translate(68, 186)" class="tassel-node" id="tassel-1">
            <line x1="0" y1="0" x2="0" y2="7" stroke="url(#zari-gold)" stroke-width="1" />
            <circle cx="0" cy="8" r="1.8" fill="url(#zari-gold)" />
          </g>
          <!-- Tassel 2 -->
          <g transform="translate(74, 188)" class="tassel-node" id="tassel-2">
            <line x1="0" y1="0" x2="0" y2="8" stroke="url(#zari-gold)" stroke-width="1" />
            <circle cx="0" cy="9.5" r="2.2" fill="url(#zari-gold)" />
          </g>
          <!-- Tassel 3 (Center) -->
          <g transform="translate(80, 190)" class="tassel-node" id="tassel-3">
            <line x1="0" y1="0" x2="0" y2="9" stroke="url(#zari-gold)" stroke-width="1.2" />
            <circle cx="0" cy="11" r="2.5" fill="url(#zari-gold)" />
            <circle cx="0" cy="11" r="1" fill="#ffffff" />
          </g>
          <!-- Tassel 4 -->
          <g transform="translate(85, 191)" class="tassel-node" id="tassel-4">
            <line x1="0" y1="0" x2="0" y2="8" stroke="url(#zari-gold)" stroke-width="1" />
            <circle cx="0" cy="9.5" r="2.2" fill="url(#zari-gold)" />
          </g>
          <!-- Tassel 5 -->
          <g transform="translate(90, 192)" class="tassel-node" id="tassel-5">
            <line x1="0" y1="0" x2="0" y2="7" stroke="url(#zari-gold)" stroke-width="1" />
            <circle cx="0" cy="8" r="1.8" fill="url(#zari-gold)" />
          </g>
        </g>
      </g>

      <!-- Archival Bottom Cartouche (Devanagari Calligraphy & Subtitle) -->
      <g class="cartouche-mount">
        <!-- Recessed Plaque Backing -->
        <rect
          x="16"
          y="172"
          width="128"
          height="31"
          rx="3"
          class="cartouche-bg"
        />
        <rect
          x="18.5"
          y="174.5"
          width="123"
          height="26"
          rx="2"
          fill="none"
          stroke="rgba(231, 176, 79, 0.22)"
          stroke-width="0.8"
        />
        <!-- 4 Corner Gold Screws/Florets -->
        <circle cx="21" cy="177" r="1.2" fill="url(#zari-gold)" />
        <circle cx="139" cy="177" r="1.2" fill="url(#zari-gold)" />
        <circle cx="21" cy="198" r="1.2" fill="url(#zari-gold)" />
        <circle cx="139" cy="198" r="1.2" fill="url(#zari-gold)" />

        <!-- Title in Devanagari & English -->
        <text
          id="silk-title"
          x="80"
          y="185"
          text-anchor="middle"
          class="cartouche-devanagari"
        >
          अक्षय वस्त्र
        </text>
        <text
          id="silk-sub"
          x="80"
          y="196"
          text-anchor="middle"
          class="cartouche-sub"
        >
          THE BOUNDLESS CLOTH · 1765
        </text>
      </g>
    </svg>
  </div>
</div>

<script>
  // Interactive Fluid Silk & Zari Cloth Controller (Pahari Miniature Simulation)
  const widget = document.getElementById('akshaya-vastra');
  const silkBody = document.getElementById('silk-body');
  const silkZariOuter = document.getElementById('silk-zari-outer');
  const silkZariStitch = document.getElementById('silk-zari-stitch');
  const silkSheen = document.getElementById('silk-sheen-path');
  const silkUnder1 = document.getElementById('silk-under-1');
  const silkUnder2 = document.getElementById('silk-under-2');
  const silkTitle = document.getElementById('silk-title');
  const silkSub = document.getElementById('silk-sub');

  const tassels = [
    document.getElementById('tassel-1'),
    document.getElementById('tassel-2'),
    document.getElementById('tassel-3'),
    document.getElementById('tassel-4'),
    document.getElementById('tassel-5'),
  ];

  if (
    widget &&
    silkBody &&
    silkZariOuter &&
    silkZariStitch &&
    silkSheen &&
    silkUnder1 &&
    silkUnder2 &&
    silkTitle &&
    silkSub
  ) {
    const elBody = silkBody;
    const elZariOuter = silkZariOuter;
    const elZariStitch = silkZariStitch;
    const elSheen = silkSheen;
    const elUnder1 = silkUnder1;
    const elUnder2 = silkUnder2;
    const elTitle = silkTitle;
    const elSub = silkSub;

    // 6 Control spine nodes representing the draped silk ribbon
    interface SpineNode {
      baseX: number;
      baseY: number;
      x: number;
      y: number;
      vx: number;
      vy: number;
      width: number;
      phase: number;
    }

    const nodes: SpineNode[] = [
      { baseX: 72, baseY: 28, x: 72, y: 28, vx: 0, vy: 0, width: 22, phase: 0 },
      { baseX: 108, baseY: 58, x: 108, y: 58, vx: 0, vy: 0, width: 28, phase: 1.1 },
      { baseX: 48, baseY: 92, x: 48, y: 92, vx: 0, vy: 0, width: 30, phase: 2.2 },
      { baseX: 114, baseY: 130, x: 114, y: 130, vx: 0, vy: 0, width: 32, phase: 3.3 },
      { baseX: 54, baseY: 165, x: 54, y: 165, vx: 0, vy: 0, width: 28, phase: 4.4 },
      { baseX: 82, baseY: 190, x: 82, y: 190, vx: 0, vy: 0, width: 24, phase: 5.5 },
    ];

    let mouseX = -999;
    let mouseY = -999;
    let isHovering = false;
    let time = 0;

    // Catmull-Rom spline to cubic Bezier curve converter
    interface Point2D {
      x: number;
      y: number;
    }

    function catmullRomToBezier(points: Point2D[]): string {
      let d = `M ${points[0].x.toFixed(1)},${points[0].y.toFixed(1)}`;
      for (let i = 0; i < points.length - 1; i++) {
        const p0 = i > 0 ? points[i - 1] : points[i];
        const p1 = points[i];
        const p2 = points[i + 1];
        const p3 = i < points.length - 2 ? points[i + 2] : p2;
        const cp1x = p1.x + (p2.x - p0.x) / 6;
        const cp1y = p1.y + (p2.y - p0.y) / 6;
        const cp2x = p2.x - (p3.x - p1.x) / 6;
        const cp2y = p2.y - (p3.y - p1.y) / 6;
        d += ` C ${cp1x.toFixed(1)},${cp1y.toFixed(1)} ${cp2x.toFixed(1)},${cp2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
      }
      return d;
    }

    // Build the filled silk polygon and zari border paths
    function updateSilkGeometry() {
      const left: Point2D[] = [];
      const right: Point2D[] = [];

      for (let i = 0; i < nodes.length; i++) {
        const prev = i > 0 ? nodes[i - 1] : nodes[i];
        const next = i < nodes.length - 1 ? nodes[i + 1] : nodes[i];
        const dx = next.x - prev.x;
        const dy = next.y - prev.y;
        const len = Math.hypot(dx, dy) || 1;
        // Normal vector (-dy, dx)
        const nx = -dy / len;
        const ny = dx / len;
        const halfW = nodes[i].width / 2;

        left.push({
          x: nodes[i].x + nx * halfW,
          y: nodes[i].y + ny * halfW,
        });
        right.push({
          x: nodes[i].x - nx * halfW,
          y: nodes[i].y - ny * halfW,
        });
      }

      // Generate forward left curve and backward right curve
      const leftBezier = catmullRomToBezier(left);
      const rightRev = [...right].reverse();
      let rightBezier = '';
      for (let i = 0; i < rightRev.length - 1; i++) {
        const p0 = i > 0 ? rightRev[i - 1] : rightRev[i];
        const p1 = rightRev[i];
        const p2 = rightRev[i + 1];
        const p3 = i < rightRev.length - 2 ? rightRev[i + 2] : p2;
        const cp1x = p1.x + (p2.x - p0.x) / 6;
        const cp1y = p1.y + (p2.y - p0.y) / 6;
        const cp2x = p2.x - (p3.x - p1.x) / 6;
        const cp2y = p2.y - (p3.y - p1.y) / 6;
        rightBezier += ` C ${cp1x.toFixed(1)},${cp1y.toFixed(1)} ${cp2x.toFixed(1)},${cp2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
      }

      const fullRibbon = `${leftBezier} L ${rightRev[0].x.toFixed(1)},${rightRev[0].y.toFixed(1)}${rightBezier} Z`;
      const zariPath = catmullRomToBezier(right);
      const sheenPath = catmullRomToBezier(
        nodes.map(n => ({ x: n.x, y: n.y }))
      );

      elBody.setAttribute('d', fullRibbon);
      elZariOuter.setAttribute('d', zariPath);
      elZariStitch.setAttribute('d', zariPath);
      elSheen.setAttribute('d', sheenPath);

      // Underside folds follow crest nodes 1 and 3
      const u1x = nodes[1].x;
      const u1y = nodes[1].y;
      elUnder1.setAttribute(
        'd',
        `M ${u1x - 30},${u1y - 32} C ${u1x - 10},${u1y - 32} ${u1x + 14},${u1y - 12} ${u1x + 10},${u1y} C ${u1x + 4},${u1y + 8} ${u1x - 18},${u1y + 6} ${u1x - 34},${u1y - 2} Z`
      );

      const u2x = nodes[3].x;
      const u2y = nodes[3].y;
      elUnder2.setAttribute(
        'd',
        `M ${u2x - 70},${u2y - 38} C ${u2x - 60},${u2y - 38} ${u2x + 14},${u2y - 8} ${u2x + 10},${u2y + 6} C ${u2x + 2},${u2y + 14} ${u2x - 26},${u2y + 10} ${u2x - 46},${u2y - 2} Z`
      );

      // Tassels sway at the hem (node 5)
      const hem = nodes[5];
      const tasselOffsets = [-14, -7, 0, 7, 14];
      tassels.forEach((tassel, idx) => {
        if (!tassel) return;
        const ox = tasselOffsets[idx];
        const sway = Math.sin(time * 2.5 + idx * 0.7) * 2.5;
        tassel.setAttribute(
          'transform',
          `translate(${hem.x + ox + sway * 0.4}, ${hem.y}) rotate(${sway * 3})`
        );
      });
    }

    // Main animation loop: spring physics + harmonic breeze
    function animate() {
      time += 0.035;

      nodes.forEach((node, i) => {
        // Ambient wind flutter (organic harmonic wave)
        const windX = Math.sin(time * 1.5 + node.phase) * (4 + i * 1.5);
        const windY = Math.cos(time * 1.2 + node.phase) * (1.5 + i * 0.4);

        let targetX = node.baseX + windX;
        let targetY = node.baseY + windY;

        // Interactive mouse wind displacement
        if (isHovering) {
          const dx = node.x - mouseX;
          const dy = node.y - mouseY;
          const dist = Math.hypot(dx, dy);
          const maxInfluence = 55;

          if (dist < maxInfluence) {
            const force = (1 - dist / maxInfluence) * 22;
            const pushAngle = Math.atan2(dy, dx);
            targetX += Math.cos(pushAngle) * force;
            targetY += Math.sin(pushAngle) * force;
          }
        }

        // Spring acceleration towards target
        const ax = (targetX - node.x) * 0.12;
        const ay = (targetY - node.y) * 0.12;

        node.vx = (node.vx + ax) * 0.78; // Damping
        node.vy = (node.vy + ay) * 0.78;

        node.x += node.vx;
        node.y += node.vy;
      });

      updateSilkGeometry();
      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);

    // Mouse Tracking across folio
    widget.addEventListener('mouseenter', () => {
      isHovering = true;
      elTitle.textContent = 'अक्षय वस्त्र';
      elSub.textContent = 'ROOM IV · NAINSUKH C. 1765';
    });

    widget.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = widget.getBoundingClientRect();
      mouseX = ((e.clientX - rect.left) / rect.width) * 160;
      mouseY = ((e.clientY - rect.top) / rect.height) * 213;
    });

    widget.addEventListener('mouseleave', () => {
      isHovering = false;
      mouseX = -999;
      mouseY = -999;
      elTitle.textContent = 'अक्षय वस्त्र';
      elSub.textContent = 'THE BOUNDLESS CLOTH · 1765';
    });

    // Touch Support for mobile interaction
    widget.addEventListener(
      'touchmove',
      (e: TouchEvent) => {
        if (!e.touches.length) return;
        const touch = e.touches[0];
        const rect = widget.getBoundingClientRect();
        mouseX = ((touch.clientX - rect.left) / rect.width) * 160;
        mouseY = ((touch.clientY - rect.top) / rect.height) * 213;
        isHovering = true;
      },
      { passive: true }
    );

    widget.addEventListener('touchend', () => {
      isHovering = false;
      mouseX = -999;
      mouseY = -999;
    });
  }
</script>

<style>
  .silk-widget {
    position: relative;
    width: 160px;
    height: 213px;
    user-select: none;
    cursor: grab;
  }

  .silk-widget:active {
    cursor: grabbing;
  }

  .silk-frame {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .silk-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (max-width: 1024px) {
    .silk-widget {
      width: 120px;
      height: 160px;
    }
  }

  @media (max-width: 720px) {
    .silk-widget {
      width: 88px;
      height: 117px;
    }
  }

  .folio-mount {
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.75));
    transition: stroke 0.3s ease;
  }

  .silk-widget:hover .folio-mount {
    stroke: #ffda79;
  }

  /* Archival Header Tag */
  .folio-curatorial-tag {
    font-family: var(--font-mono, monospace);
    font-size: 6px;
    font-weight: 700;
    fill: rgba(231, 176, 79, 0.65);
    letter-spacing: 0.12em;
  }

  /* Silk Body Shading & Depth */
  .silk-body-path {
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.85));
    transition: filter 0.2s ease;
  }

  .silk-widget:hover .silk-body-path {
    filter: drop-shadow(0 8px 18px rgba(189, 24, 45, 0.45));
  }

  .zari-outer {
    filter: drop-shadow(0 0 4px rgba(231, 176, 79, 0.6));
  }

  /* Gold Flakes Floating Animation */
  .gold-flakes .flake {
    animation: flakeDrift 4s ease-in-out infinite alternate;
  }

  .gold-flakes .f1 {
    animation-delay: 0s;
  }
  .gold-flakes .f2 {
    animation-delay: 0.8s;
  }
  .gold-flakes .f3 {
    animation-delay: 1.6s;
  }
  .gold-flakes .f4 {
    animation-delay: 2.4s;
  }
  .gold-flakes .f5 {
    animation-delay: 3.2s;
  }
  .gold-flakes .f6 {
    animation-delay: 1.2s;
  }

  @keyframes flakeDrift {
    0% {
      transform: translateY(0px) scale(0.9);
      opacity: 0.4;

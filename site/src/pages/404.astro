---
import Base from '../layouts/Base.astro';
import SpaceHead from '../components/SpaceHead.astro';
import NextLinks from '../components/NextLinks.astro';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <SpaceHead title="Page not found" lede="Nothing lives at this address. It may have moved when the site was rebuilt.">
    <p><a href="/search/">Search the site</a> or start from one of these.</p>
  </SpaceHead>
  <NextLinks
    links={[
      { href: '/', label: 'Home' },
      { href: '/work/', label: 'Work' },
      { href: '/personal/', label: 'Off the clock: art, books and films' },
    ]}
  />
</Base>

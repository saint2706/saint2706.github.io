---
import Base from '../../../layouts/Base.astro';
import { paintings, gallery } from '../../../lib/content';

export function getStaticPaths() {
  return paintings.map(p => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const order = gallery.rooms.flatMap(r => r.works);
const i = order.indexOf(p.slug);
const bySlug = (s: string | undefined) => paintings.find(x => x.slug === s);
const prev = bySlug(order[i - 1]);
const next = bySlug(order[i + 1]);
const room = gallery.rooms.find(r => r.works.includes(p.slug))!;
const source = (id: string | null | undefined) => p.sources.find(s => s.id === id);
const imgSource = source(p.image.source);
// Marker overlay in image pixels, so badge text keeps its shape (inline style attributes would break the CSP).
const [W, H] = [p.image.width, p.image.height];
const B = Math.round(W / 40);
---

<Base
  title={`${p.title}, ${p.artist}`}
  description={`${p.title} (${p.date}) by ${p.artist}: details, context, two readings and a question.`}
  space="per"
>
  <p class="crumb"><a href="/personal/art/">Art and myth</a> · Room {room.numeral}, {room.name}</p>
  <header class="head">
    <h1>{p.title}</h1>
    <p class="by">{p.artist}, {p.date}</p>
    {p.note && <p class="meta">{p.note}</p>}
  </header>

  <figure class="work">
    <div class="frame">
      <img src={p.image.src} width={p.image.width} height={p.image.height} alt={`${p.title}, ${p.artist}`} />
      <svg class="marks" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
        {
          p.details.map((d, n) => {
            const [x, y, w, h] = [(d.rect[0] * W) / 100, (d.rect[1] * H) / 100, (d.rect[2] * W) / 100, (d.rect[3] * H) / 100];
            return (
              <g>
                <rect x={x} y={y} width={w} height={h} />
                <rect class="badge" x={x} y={y} width={B * 1.4} height={B * 1.4} />
                <text x={x + B * 0.7} y={y + B} text-anchor="middle" font-size={B}>
                  {n + 1}
                </text>
              </g>
            );
          })
        }
      </svg>
    </div>
    <label class="toggle"><input type="checkbox" /> Show where the details are</label>
    <figcaption>
      {p.artist}, <cite>{p.title}</cite>, {p.date}. {p.medium}, {p.dims}. {p.holder}, {p.holderRef}.
      <span class="credit">
        {p.image.credit}
        {imgSource && <a href={imgSource.url}>Image source</a>}
      </span>
    </figcaption>
  </figure>

  <section class="part" aria-labelledby="look">
    <h2 id="look">Look first</h2>
    <p class="lead">{p.look}</p>
  </section>

  <section class="part" aria-labelledby="details">
    <h2 id="details">Details</h2>
    <ol class="details">
      {
        p.details.map(d => (
          <li>
            <img src={d.src} width={d.width} height={d.height} alt="" loading="lazy" decoding="async" />
            <h3>{d.label}</h3>
            <p>{d.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    p.story && (
      <section class="part" aria-labelledby="story">
        <h2 id="story">The dice hall</h2>
        <p>
          From the Sabhaparvan, the second book of the Mahabharata. Steps marked <strong>Later retellings</strong> come
          from outside the critical edition of the Sanskrit text.
        </p>
        <ol class="story">
          {p.story.map(s => (
            <li class={s.kind}>
              {s.kind === 'ret' && <strong class="rt">Later retellings</strong>}
              {s.text}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="part" aria-labelledby="context">
    <h2 id="context">Context</h2>
    <ul class="claims">
      {
        p.context.map(c => {
          const s = source(c.source);
          return (
            <li>
              <span class={`tag tag-${c.tag}`}>{c.label}</span>
              <p>
                {c.text}
                {s && (
                  <>
                    {' '}
                    <a class="src" href={s.url}>
                      Source
                    </a>
                  </>
                )}
              </p>
            </li>
          );
        })
      }
    </ul>
    {
      p.quote && (
        <blockquote>
          <p lang="es">{p.quote.es}</p>
          <p>{p.quote.en}</p>
          <footer class="meta">{p.quote.cite}</footer>
        </blockquote>
      )
    }
  </section>

  <section class="part" aria-labelledby="readings">
    <h2 id="readings">Two readings</h2>
    <div class="readings">
      {
        p.readings.map(r => (
          <article>
            <span class={`tag tag-${r.tag}`}>{r.label}</span>
            <h3>{r.name}</h3>
            <dl>
              <dt>Evidence</dt>
              <dd>{r.evidence}</dd>
              <dt>What it shows</dt>
              <dd>{r.lit}</dd>
              <dt>What it leaves open</dt>
              <dd>{r.open}</dd>
            </dl>
          </article>
        ))
      }
    </div>
    {
      p.extra && (
        <article class="extra">
          <span class={`tag tag-${p.extra.tag}`}>{p.extra.label}</span>
          <h3>{p.extra.name}</h3>
          <p>{p.extra.text}</p>
        </article>
      )
    }
  </section>

  {
    p.technical && (
      <section class="part" aria-labelledby="technical">
        <h2 id="technical">Under the paint</h2>
        <ul class="plain-list">
          {p.technical.map(t => (
            <li>{t}</li>
          ))}
        </ul>
        {p.technicalNote && <p class="aside">{p.technicalNote}</p>}
      </section>
    )
  }

  <section class="part question" aria-labelledby="question">
    <h2 id="question">The question</h2>
    <p class="q">{p.question}</p>
    {
      p.follow.length > 0 && (
        <ul class="plain-list">
          {p.follow.map(f => (
            <li>{f}</li>
          ))}
        </ul>
      )
    }
    {
      p.ladder && (
        <>
          <h3>Who is responsible?</h3>
          <ol class="plain-list">
            {p.ladder.map(l => (
              <li>{l}</li>
            ))}
          </ol>
        </>
      )
    }
    <h3>Push back</h3>
    <p>{p.counter}</p>
    <h3>Now</h3>
    <p>{p.now}</p>
    <figure class="focus">
      <img src={p.focus.src} width={p.focus.width} height={p.focus.height} alt="" loading="lazy" decoding="async" />
      <figcaption>{p.focus.caption}</figcaption>
    </figure>
  </section>

  <section class="part" aria-labelledby="sources">
    <h2 id="sources">Sources</h2>
    <ul class="plain-list sources">
      {
        p.sources.map(s => (
          <li>
            <a href={s.url}>{s.title}</a>
          </li>
        ))
      }
      {
        p.view && (
          <li>
            <a href={p.view.u}>{p.view.label}</a>
          </li>
        )
      }
    </ul>
  </section>

  <nav class="next" aria-label="Paintings">
    {prev && <a href={`/personal/art/${prev.slug}/`}>Previous: {prev.title}</a>}
    {next && <a href={`/personal/art/${next.slug}/`}>Next: {next.title}</a>}
    <a href="/personal/art/">All paintings</a>
  </nav>
</Base>

<style>
  .crumb {
    margin: 0 0 var(--space-3);
    font-size: var(--text-n1);
  }
  .head h1 {
    margin: 0;
    font: var(--text-5) / 1.05 var(--font-display);
  }
  .head .by {
    margin: var(--space-2) 0 0;
    font-size: var(--text-1);
  }
  .work {
    margin: var(--space-5) 0 0;
  }
  .frame {
    position: relative;
    width: fit-content;
    max-width: 100%;
    border: 2px solid var(--color-ink);
    background: var(--color-surface);
    padding: 12px;
  }
  .frame img {
    display: block;
    max-width: 100%;
    height: auto;
    max-height: 80vh;
    width: auto;
  }
  .marks {
    display: none;
    position: absolute;
    top: 12px;
    left: 12px;
    width: calc(100% - 24px);
    height: calc(100% - 24px);
  }
  .work:has(.toggle input:checked) .marks {
    display: block;
  }
  .marks rect {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 3px;
    vector-effect: non-scaling-stroke;
  }
  .marks .badge {
    fill: var(--color-accent);
  }
  .marks text {
    fill: var(--color-canvas);
    font-family: var(--font-mono);
  }
  .toggle {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-2);
    cursor: pointer;
  }
  .toggle input {
    width: 20px;
    height: 20px;
    accent-color: var(--color-accent);
  }
  .work figcaption {
    max-width: 70ch;
    font-size: var(--text-n1);
    color: var(--color-ink-2);
  }
  .credit {
    display: block;
    margin-top: var(--space-1);
  }
  .part {
    margin-top: var(--space-6);
    max-width: 70ch;
  }
  .part h2 {
    font: var(--text-2) / 1.2 var(--font-display);
    margin: 0 0 var(--space-3);
  }
  .part h3 {
    font-size: var(--text-1);
    margin: var(--space-4) 0 var(--space-2);
  }
  .lead {
    font-size: var(--text-1);
  }
  .details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    counter-reset: d;
  }
  .details li {
    counter-increment: d;
  }
  .details img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 2px solid var(--color-ink);
  }
  .details h3::before {
    content: counter(d) '. ';
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .story {
    padding-left: 24px;
  }
  .story li {
    padding: 4px 0;
  }
  .story .ret {
    background: var(--color-surface);
    padding: 8px 12px;
  }
  .story .rt {
    display: block;
    font: var(--text-n1) / 1.4 var(--font-mono);
    color: var(--color-accent);
  }
  .claims {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .claims li {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-rule);
  }
  .claims p {
    margin: var(--space-2) 0 0;
  }
  blockquote {
    margin: var(--space-4) 0 0;
    padding-left: var(--space-3);
    border-left: 4px solid var(--color-accent);
  }
  blockquote p {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-1);
  }
  .readings {
    display: grid;
    gap: var(--space-4);
  }
  .readings article,
  .extra {
    border: 2px solid var(--color-ink);
    background: var(--color-surface);
    padding: var(--space-4);
  }
  .extra {
    margin-top: var(--space-4);
  }
  .readings h3,
  .extra h3 {
    margin-top: var(--space-2);
  }
  dl {
    margin: 0;
  }
  dt {
    font: var(--text-n1) / 1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--color-ink-2);
    margin-top: var(--space-3);
  }
  dd {
    margin: var(--space-1) 0 0;
  }
  .plain-list {
    padding-left: 24px;
  }
  .plain-list li {
    padding: 4px 0;
  }
  .aside {
    color: var(--color-ink-2);
    font-size: var(--text-n1);
  }
  .sources li {
    overflow-wrap: anywhere;
  }
  .q {
    font: var(--text-2) / 1.3 var(--font-display);
  }
  .focus {
    margin: var(--space-4) 0 0;
  }
  .focus img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 2px solid var(--color-ink);
  }
  .focus figcaption {
    font-size: var(--text-n1);
    color: var(--color-ink-2);
    margin-top: var(--space-1);
  }
</style>

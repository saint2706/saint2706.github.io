---
import Base from '../../../layouts/Base.astro';
import { paintings, gallery } from '../../../lib/content';

export function getStaticPaths() {
  return paintings.map(p => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const order = gallery.rooms.flatMap(r => r.works);
const i = order.indexOf(p.slug);
const bySlug = (s: string | undefined) => paintings.find(x => x.slug === s);
const prev = bySlug(order[i - 1]);
const next = bySlug(order[i + 1]);
const room = gallery.rooms.find(r => r.works.includes(p.slug))!;
const prevRoom = prev ? gallery.rooms.find(r => r.works.includes(prev.slug)) : null;
const nextRoom = next ? gallery.rooms.find(r => r.works.includes(next.slug)) : null;
const source = (id: string | null | undefined) => p.sources.find(s => s.id === id);
const imgSource = source(p.image.source);

// Marker overlay in image pixels, so badge text keeps its shape (inline style attributes would break the CSP).
const [W, H] = [p.image.width, p.image.height];
const B = Math.round(W / 40);
---

<Base
  title={`${p.title}, ${p.artist}`}
  description={`${p.title} (${p.date}) by ${p.artist}: details, context, two readings and a question.`}
  space="per"
>
  <!-- Architectural Room Breadcrumb -->
  <nav class="monograph-crumb" aria-label="Curatorial Breadcrumb">
    <a href="/personal/art/" class="crumb-link">Art and myth</a>
    <span class="crumb-sep" aria-hidden="true">/</span>
    <span class="crumb-room">Hall {room.numeral}: {room.name}</span>
    <span class="crumb-sep" aria-hidden="true">/</span>
    <span class="crumb-acc">Cat. {String(p.n).padStart(2, '0')}</span>
  </nav>

  <!-- Editorial Monograph Header -->
  <header class="monograph-head">
    <div class="head-eyebrow">
      <span class="hall-tag">ROOM {room.numeral} · {room.name.toUpperCase()}</span>
      <span class="date-tag">{p.date}</span>
    </div>
    <h1 class="monograph-title">{p.title}</h1>
    <p class="monograph-by">{p.artist}</p>
    {p.note && <div class="curatorial-attribution-note">{p.note}</div>}
  </header>

  <!-- Physical Picture Frame with Track Lighting -->
  <figure class="monograph-stage">
    <div class="frame-spotlight">
      <div class="frame-outer">
        <div class="frame-fillet">
          <div class="frame-mat">
            <div class="frame-canvas">
              <img
                src={p.image.src}
                width={p.image.width}
                height={p.image.height}
                alt={`${p.title}, by ${p.artist}`}
                loading="eager"
                decoding="async"
              />
              <svg class="marks" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
                {
                  p.details.map((d, n) => {
                    const [x, y, w, h] = [(d.rect[0] * W) / 100, (d.rect[1] * H) / 100, (d.rect[2] * W) / 100, (d.rect[3] * H) / 100];
                    return (
                      <g class="mark-group">
                        <rect class="mark-box" x={x} y={y} width={w} height={h} rx={4} />
                        <rect class="mark-badge" x={x} y={y} width={B * 1.5} height={B * 1.5} rx={3} />
                        <text x={x + B * 0.75} y={y + B * 1.08} text-anchor="middle" font-size={B}>
                          {n + 1}
                        </text>
                      </g>
                    );
                  })
                }
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Hotspot Toggle Control -->
    <div class="stage-toolbar">
      <label class="hotspot-toggle">
        <input type="checkbox" id="hotspot-switch" />
        <span class="toggle-track"></span>
        <span class="toggle-label">Show detail coordinates & focal rectangles</span>
      </label>
      <span class="stage-dims-note">{p.dims} (original scale)</span>
    </div>

    <!-- Interactive Detail Crop Ribbon -->
    <nav class="detail-ribbon" aria-label="Painting focal details ribbon">
      <div class="ribbon-summary">
        <span class="ribbon-count">{p.details.length}</span>
        <span class="ribbon-label">Details</span>
      </div>
      <div class="ribbon-scroll">
        {
          p.details.map((d, idx) => (
            <a href={`#detail-${idx + 1}`} class="ribbon-chip" title={`Examine Detail ${idx + 1}: ${d.label}`}>
              <span class="chip-frame">
                <img src={d.src} width={d.width} height={d.height} alt="" loading="lazy" decoding="async" />
              </span>
              <div class="chip-info">
                <span class="chip-badge">0{idx + 1}</span>
                <span class="chip-title">{d.label}</span>
              </div>
            </a>
          ))
        }
      </div>
    </nav>

    <!-- Museum Accession Wall Plaque (Cartellino) -->
    <div class="accession-plaque" aria-label="Museum accession record">
      <div class="plaque-frieze">
        <span class="plaque-stamp">CURATORIAL ACCESSION RECORD</span>
        <span class="plaque-hall">HALL {room.numeral}: {room.name} · CAT. {String(p.n).padStart(2, '0')}</span>
      </div>

      <div class="plaque-body">
        <div class="plaque-meta-grid">
          <div class="plaque-item">
            <span class="plaque-k">ARTIST</span>
            <span class="plaque-v">{p.artist}</span>
          </div>
          <div class="plaque-item">
            <span class="plaque-k">DATE</span>
            <span class="plaque-v">{p.date}</span>
          </div>
          <div class="plaque-item">
            <span class="plaque-k">MEDIUM</span>
            <span class="plaque-v">{p.medium}</span>
          </div>
          <div class="plaque-item">
            <span class="plaque-k">DIMENSIONS</span>
            <span class="plaque-v">{p.dims}</span>
          </div>
        </div>

        <div class="plaque-holder-row">
          <span class="plaque-k">CURRENT REPOSITORY</span>
          <span class="plaque-v-bold">{p.holder} — <span class="plaque-ref">{p.holderRef}</span></span>
        </div>

        <div class="plaque-provenance">
          <p class="plaque-credit">{p.image.credit}</p>
          <div class="plaque-links">
            {imgSource && (
              <a href={imgSource.url} class="plaque-link" target="_blank" rel="noopener noreferrer">
                Official Image Repository ↗
              </a>
            )}
            {p.view && (
              <a href={p.view.u} class="plaque-link" target="_blank" rel="noopener noreferrer">
                {p.view.label} ↗
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </figure>

  <!-- Look First Section -->
  <section class="monograph-section look-section" aria-labelledby="look">
    <div class="section-tag-row">
      <span class="section-pill">INVITATION TO SEE</span>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <h2 id="look" class="section-heading">Look first</h2>
    <p class="look-lead">{p.look}</p>
    <p class="look-hint">
      Before consulting the historical scholarship or readings below, take in the whole visual plane.
      Notice where your gaze travels first—and what was made quiet.
    </p>
  </section>

  <!-- Curated Details Deep-Dive -->
  <section class="monograph-section" aria-labelledby="details">
    <div class="section-tag-row">
      <span class="section-pill">MICROSCOPIC EXAMINATION</span>
      <span class="section-count">{p.details.length} focal points catalogued</span>
    </div>
    <h2 id="details" class="section-heading">Details under the loupe</h2>
    <p class="section-lead">
      Move through the composition in high resolution. Each numbered crop highlights a deliberate
      decision in framing, light, peripheral presence, or symbolic subversion.
    </p>

    <div class="details-dossier">
      {
        p.details.map((d, idx) => (
          <article id={`detail-${idx + 1}`} class="detail-card">
            <div class="detail-crop-stage">
              <div class="detail-crop-frame">
                <img src={d.src} width={d.width} height={d.height} alt={d.label} loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="detail-narrative">
              <div class="detail-meta-bar">
                <span class="detail-num-badge">DETAIL 0{idx + 1}</span>
                <span class="detail-rect-spec">COORDINATES: [{d.rect.join(', ')}]</span>
              </div>
              <h3 class="detail-title">{d.label}</h3>
              <p class="detail-text">{d.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Chronicle / Story (e.g. Sabhaparvan in Draupadi) -->
  {
    p.story && (
      <section class="monograph-section story-section" aria-labelledby="story">
        <div class="section-tag-row">
          <span class="section-pill">TEXTUAL CHRONICLE</span>
          <span class="section-count">Sabhaparvan Narrative</span>
        </div>
        <h2 id="story" class="section-heading">The dice hall</h2>
        <p class="section-lead">
          From the Sabhaparvan, the second book of the Mahabharata. Steps marked <strong>Later retellings</strong> come
          from outside the critical edition of the Sanskrit text.
        </p>
        <ol class="story-chronicle">
          {p.story.map(s => (
            <li class={s.kind}>
              {s.kind === 'ret' && <span class="story-ret-badge">LATER RETELLINGS</span>}
              <p class="story-text">{s.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <!-- Historical Context & Documentary Evidence -->
  <section class="monograph-section" aria-labelledby="context">
    <div class="section-tag-row">
      <span class="section-pill">ARCHIVAL EVIDENCE</span>
      <span class="section-count">{p.context.length} contextual records</span>
    </div>
    <h2 id="context" class="section-heading">Context</h2>
    <ul class="claims-list">
      {
        p.context.map(c => {
          const s = source(c.source);
          return (
            <li class="claim-item">
              <div class="claim-tag-row">
                <span class={`tag tag-${c.tag}`}>{c.label}</span>
                {s && (
                  <a class="claim-src" href={s.url} target="_blank" rel="noopener noreferrer">
                    Verified Citation ↗
                  </a>
                )}
              </div>
              <p class="claim-text">{c.text}</p>
            </li>
          );
        })
      }
    </ul>

    {
      p.quote && (
        <blockquote class="archival-quote">
          <p class="quote-es" lang="es">“{p.quote.es}”</p>
          <p class="quote-en">“{p.quote.en}”</p>
          <footer class="quote-footer">
            <cite class="quote-cite">{p.quote.cite}</cite>
          </footer>
        </blockquote>
      )
    }
  </section>

  <!-- Two Readings (The Central Debate) -->
  <section class="monograph-section readings-section" aria-labelledby="readings">
    <div class="section-tag-row">
      <span class="section-pill">COMPETING HISTORIOGRAPHY</span>
      <span class="section-count">Two Readings</span>
    </div>
    <h2 id="readings" class="section-heading">Two readings</h2>
    <p class="section-lead">
      Art historical scholarship is not a single consensus. Below are two competing interpretations of this work,
      grounded in physical and documentary evidence.
    </p>

    <div class="readings-grid">
      {
        p.readings.map((r, idx) => (
          <article class="reading-card">
            <div class="reading-header">
              <span class={`tag tag-${r.tag}`}>{r.label}</span>
              <span class="reading-letter">READING {idx === 0 ? 'A' : 'B'}</span>
            </div>
            <h3 class="reading-name">{r.name}</h3>

            <dl class="reading-dl">
              <div class="reading-row">
                <dt>Physical & Archival Evidence</dt>
                <dd>{r.evidence}</dd>
              </div>
              <div class="reading-row">
                <dt>What this reading reveals</dt>
                <dd>{r.lit}</dd>
              </div>
              <div class="reading-row open-field">
                <dt>What it leaves open / unanswered</dt>
                <dd>{r.open}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>

    {
      p.extra && (
        <article class="extra-card">
          <div class="reading-header">
            <span class={`tag tag-${p.extra.tag}`}>{p.extra.label}</span>
            <span class="reading-letter">SCHOLARLY ADDENDUM</span>
          </div>
          <h3 class="reading-name">{p.extra.name}</h3>
          <p class="extra-text">{p.extra.text}</p>
        </article>
      )
    }
  </section>

  <!-- Under the Paint (Technical Examination) -->
  {
    p.technical && (
      <section class="monograph-section" aria-labelledby="technical">
        <div class="section-tag-row">
          <span class="section-pill">FORENSIC CONSERVATION</span>
          <span class="section-count">Material Analysis</span>
        </div>
        <h2 id="technical" class="section-heading">Under the paint</h2>
        <ul class="technical-list">
          {p.technical.map(t => (
            <li>{t}</li>
          ))}
        </ul>
        {p.technicalNote && <p class="technical-aside">{p.technicalNote}</p>}
      </section>
    )
  }

  <!-- The Climactic Question -->
  <section class="monograph-section question-section" aria-labelledby="question">
    <div class="question-banner">
      <span class="question-pill">THE QUESTION TO ARGUE ABOUT</span>
      <h2 id="question" class="question-heading">{p.question}</h2>
    </div>

    {
      p.follow.length > 0 && (
        <div class="question-follow">
          <h3 class="sub-heading">Follow-up inquiries</h3>
          <ul class="inquiry-list">
            {p.follow.map(f => (
              <li>{f}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      p.ladder && (
        <div class="question-ladder">
          <h3 class="sub-heading">Who is responsible? (The Moral Ladder)</h3>
          <ol class="ladder-list">
            {p.ladder.map((l, idx) => (
              <li class="ladder-item">
                <span class="ladder-rank">{String(idx + 1).padStart(2, '0')}</span>
                <span class="ladder-text">{l}</span>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    <div class="dialectic-grid">
      <div class="dialectic-card pushback">
        <h3 class="sub-heading">Push back</h3>
        <p class="dialectic-text">{p.counter}</p>
      </div>

      <div class="dialectic-card now">
        <h3 class="sub-heading">Now</h3>
        <p class="dialectic-text">{p.now}</p>
      </div>
    </div>

    <figure class="focus-figure">
      <div class="focus-frame">
        <img src={p.focus.src} width={p.focus.width} height={p.focus.height} alt="" loading="lazy" decoding="async" />
      </div>
      <figcaption class="focus-caption">{p.focus.caption}</figcaption>
    </figure>
  </section>

  <!-- Sources & Image Provenance -->
  <section class="monograph-section" aria-labelledby="sources">
    <div class="section-tag-row">
      <span class="section-pill">BIBLIOGRAPHY</span>
      <span class="section-count">Verified Sources</span>
    </div>
    <h2 id="sources" class="section-heading">Sources</h2>
    <ul class="sources-list">
      {
        p.sources.map(s => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.title}
              <span class="src-ext" aria-hidden="true"> ↗</span>
            </a>
          </li>
        ))
      }
      {
        p.view && (
          <li>
            <a href={p.view.u} target="_blank" rel="noopener noreferrer">
              {p.view.label}
              <span class="src-ext" aria-hidden="true"> ↗</span>
            </a>
          </li>
        )
      }
    </ul>
  </section>

  <!-- Architectural Room Bridges (Navigation) -->
  <nav class="room-bridge-nav" aria-label="Museum Navigation Bridges">
    <div class="bridge-grid">
      {
        prev ? (
          <a href={`/personal/art/${prev.slug}/`} class="bridge-card prev">
            <span class="bridge-dir">‹ PREVIOUS WORK IN HALL {prevRoom?.numeral}</span>
            <span class="bridge-title">{prev.title}</span>
            <span class="bridge-artist">{prev.artist}, {prev.date}</span>
          </a>
        ) : (
          <div class="bridge-card terminus">
            <span class="bridge-dir">COLLECTION OPENING</span>
            <span class="bridge-title">Room I Entrance</span>
          </div>
        )
      }

      <a href="/personal/art/" class="bridge-card hub">
        <span class="bridge-dir">EXHIBITION OVERVIEW</span>
        <span class="bridge-title">All 7 Works on View</span>
        <span class="bridge-artist">Rooms I – IV</span>
      </a>

      {
        next ? (
          <a href={`/personal/art/${next.slug}/`} class="bridge-card next">
            <span class="bridge-dir">NEXT WORK IN HALL {nextRoom?.numeral} ›</span>
            <span class="bridge-title">{next.title}</span>
            <span class="bridge-artist">{next.artist}, {next.date}</span>
          </a>
        ) : (
          <div class="bridge-card terminus">
            <span class="bridge-dir">COLLECTION CLIMAX</span>
            <span class="bridge-title">Room IV Conclusion</span>
          </div>
        )
      }
    </div>
  </nav>
</Base>

<style>
  /* Curatorial Breadcrumb */
  .monograph-crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 var(--space-4);
    font: var(--text-n1) / 1.4 var(--font-mono);
    color: var(--color-ink-2);
  }
  .crumb-link {
    color: var(--color-accent);
    text-decoration: none;
  }
  .crumb-link:hover,
  .crumb-link:focus-visible {
    text-decoration: underline;
  }
  .crumb-sep {
    color: var(--per-rule);
    user-select: none;
  }
  .crumb-room {
    color: var(--color-ink);
  }
  .crumb-acc {
    color: var(--color-accent);
    font-weight: 700;
  }

  /* Monograph Header */
  .monograph-head {
    margin-bottom: var(--space-5);
    max-width: 78ch;
  }
  .head-eyebrow {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .hall-tag {
    font: 700 0.75rem / 1 var(--font-mono);
    color: var(--color-accent);
    letter-spacing: 0.08em;
  }
  .date-tag {
    font: 0.75rem / 1 var(--font-mono);
    color: var(--color-ink-2);
  }
  .monograph-title {
    margin: 0;
    font: var(--text-5) / 1.05 var(--font-display);
    color: var(--color-ink);
  }
  .monograph-by {
    margin: var(--space-2) 0 0;
    font: var(--text-1) / 1.4 var(--font-body);
    color: var(--color-accent);
  }
  .curatorial-attribution-note {
    margin-top: var(--space-3);
    padding: 8px 12px;
    border-left: 2px solid var(--per-rule);
    background: var(--per-surface);
    font: italic var(--text-n1) / 1.45 var(--font-body);
    color: var(--color-ink-2);
  }

  /* Physical Picture Frame & Stage */
  .monograph-stage {
    margin: var(--space-5) 0 var(--space-6);
  }
  .frame-spotlight {
    position: relative;
    padding: var(--space-6) var(--space-4);
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, rgba(231, 176, 79, 0.14), transparent 75%),
      #120a15;
    border: 1px solid var(--per-rule);
    border-bottom: 5px solid #0d060f;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
  }
  .frame-outer {
    max-width: 100%;
    background: #140d17;
    border: 4px solid #2d1e33;
    padding: 8px;
    box-shadow:
      inset 0 0 0 1px #0a040d,
      0 20px 40px rgba(0, 0, 0, 0.7);
  }
  .frame-fillet {
    border: 2px solid #b8893a;
    padding: 4px;
    background: #1d1222;
  }
  .frame-mat {
    padding: 12px;
    background: #241628;
    box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.7);
  }
  .frame-canvas {
    position: relative;
    display: block;
    max-width: 100%;
  }
  .frame-canvas img {
    display: block;
    max-width: 100%;
    height: auto;
    max-height: 80vh;
    width: auto;
  }
  .marks {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .monograph-stage:has(#hotspot-switch:checked) .marks {
    display: block;
  }
  .mark-box {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 3px;
    stroke-dasharray: 6 4;
    vector-effect: non-scaling-stroke;
  }
  .mark-badge {
    fill: var(--color-accent);
  }
  .marks text {
    fill: #120c14;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  /* Stage Toolbar & Hotspot Switch */
  .stage-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: 8px var(--space-3);
    background: var(--per-surface);
    border: 1px solid var(--per-rule);
  }
  .hotspot-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }
  .hotspot-toggle input {
    width: 18px;
    height: 18px;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .toggle-label {
    font: 700 0.8rem / 1 var(--font-mono);
    color: var(--color-ink);
    letter-spacing: 0.04em;
  }
  .stage-dims-note {
    font: 0.75rem / 1 var(--font-mono);
    color: var(--color-ink-2);
  }

  /* Interactive Detail Crop Ribbon */
  .detail-ribbon {
    margin-top: var(--space-3);
    border: 1px solid var(--per-rule);
    background: #19101c;
    padding: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    overflow: hidden;
  }
  .ribbon-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-right: var(--space-3);
    border-right: 1px solid var(--per-rule);
    min-width: 60px;
  }
  .ribbon-count {
    font: 700 1.25rem / 1 var(--font-mono);
    color: var(--color-accent);
  }
  .ribbon-label {
    font: 0.7rem / 1 var(--font-mono);
    color: var(--color-ink-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 2px;
  }
  .ribbon-scroll {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }
  .ribbon-chip {

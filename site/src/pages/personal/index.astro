---
import Base from '../../layouts/Base.astro';
import SpaceHead from '../../components/SpaceHead.astro';
import NextLinks from '../../components/NextLinks.astro';
import { rooms } from '../../lib/content';
---

<Base
  title="Off the clock"
  description="The personal side of the site: art and myth, and a philosophy reading path, kept apart from the work pages."
  space="per"
>
  <SpaceHead title="Off the clock" lede="Art, myth and the books on the shelf. Pick a room." />

  <ul class="room-list">
    {
      rooms.map((r, i) => (
        <li>
          <a href={r.href}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="t">{r.label}</span>
            <span class="meta">{r.blurb}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <NextLinks
    links={[
      { href: '/work/', label: 'Back to work' },
      { href: '/lab/', label: 'The lab: experiments' },
    ]}
  />
</Base>

<script>
  // Links from before the rooms split pointed at sections of this page.
  const moved: Record<string, string> = { '#art': '/personal/art/', '#books': '/personal/books/' };
  if (moved[location.hash]) location.replace(moved[location.hash]);
</script>

<style>
  .room-list {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-4);
  }
  .room-list a {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
    border: 2px solid var(--color-ink);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
  }
  .room-list .num {
    color: var(--color-accent);
    font: var(--text-n1) / 1.3 var(--font-mono);
    letter-spacing: 0.04em;
  }
  .room-list .t {
    font: var(--text-2) / 1.15 var(--font-display);
  }
  .room-list .meta {
    color: var(--color-ink-2);
  }
  .room-list a:hover .t,
  .room-list a:focus-visible .t {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
</style>

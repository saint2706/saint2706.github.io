const freeCount = curatedBooks.filter(b => b.access === 'FREE').length;
const borrowCount = curatedBooks.filter(b => b.access === 'BORROW').length;
const commercialCount = curatedBooks.filter(b => b.access === 'COMMERCIAL').length;
---

<Base
  title="Books"
  description="Twenty-five books that stayed with me: philosophy from Homer to Wittgenstein."
  space="per"
>
  <SpaceHead
    title="Books"
    lede="Twenty-five books that stayed with me: philosophy from Homer to Wittgenstein."
  >
    <p class="curator-letter">
      These are twenty-five books I’ve loved and kept returning to. Some made me rethink how I live,
      others argued with me for months, and a few are just extraordinary writing. If you’re curious about
      any of them, click on any spine to pull it from the shelf, or browse the open links below.
    </p>
  </SpaceHead>

  <!-- Library Ledger Summary Bar -->
  <div class="ledger-bar" aria-label="Library collection summary">
    <div class="ledger-item">
      <span class="ledger-num">05</span>
      <span class="ledger-label">Historical Eras</span>
    </div>
    <span class="ledger-sep" aria-hidden="true">/</span>
    <div class="ledger-item">
      <span class="ledger-num">25</span>
      <span class="ledger-label">Volumes</span>
    </div>
    <span class="ledger-sep" aria-hidden="true">/</span>
    <div class="ledger-item">
      <span class="ledger-num">{freeCount}</span>
      <span class="ledger-label">Free to Read</span>
    </div>
    <span class="ledger-sep" aria-hidden="true">/</span>
    <div class="ledger-item">
      <span class="ledger-num">{borrowCount}</span>
      <span class="ledger-label">Library Loans</span>
    </div>
  </div>

  <!-- Tiered Library Bookshelf -->
  <Section id="shelf" num={1} title="The library bookcase">
    <div class="bookshelf-guidance">
      <span class="shelf-lamp" aria-hidden="true">✦</span>
      <p class="shelf-instruction">
        Browse the tiered shelves below. Hover to pull a book from the shelf, or click any spine to inspect its folio and online access link.
      </p>
    </div>

    <div class="library-bookcase" aria-label="Tiered Philosophy Bookshelf">
      {
        eras.map(era => {
          const eraBooks = curatedBooks.filter(b => b.era === era.num);
          return (
            <div class="shelf-tier" id={`tier-${era.num}`}>
              <div class="shelf-bay">
                <div class="bookend left" aria-hidden="true">
                  <span class="bookend-brass" />
                </div>

                <div class="shelf-books" role="list" aria-label={`Shelf ${era.numeral}: ${era.name}`}>
                  {eraBooks.map(b => (
                    <button
                      type="button"
                      class:list={['shelf-spine', b.heightClass, b.widthClass, `tone-${b.tone}`]}
                      data-shelf-spine
                      data-book-trigger={b.id}
                      data-access={b.access}
                      data-era={b.era}
                      aria-label={`${b.title} by ${b.author}. Click to open folio.`}
                    >
                      <span class="spine-top-band" aria-hidden="true" />
                      <span class="spine-title-vertical">{b.title}</span>
                      <span class="spine-author-vertical">{b.author}</span>
                      <span class="spine-bottom-band" aria-hidden="true" />
                      <span class="spine-ribbon" aria-hidden="true" />
                    </button>
                  ))}
                </div>

                <div class="bookend right" aria-hidden="true">
                  <span class="bookend-brass" />
                </div>
              </div>

              <!-- Wooden Shelf Ledge with Centered Brass Plaque -->
              <div class="shelf-ledge">
                <div class="shelf-plaque">
                  <span class="plaque-rivet left" aria-hidden="true">●</span>
                  <span class="plaque-text">ERA {era.numeral} · {era.name.toUpperCase()} <span class="plaque-years">({era.years})</span></span>
                  <span class="plaque-rivet right" aria-hidden="true">●</span>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </Section>

  <!-- Filter Bar & Era Folios Section -->
  <Section id="catalog" num={2} title="Volumes and reading notes">
    <div class="filter-cluster">
      <div class="filter-pills" role="toolbar" aria-label="Book catalog filter options">
        <button class="filter-btn active" type="button" data-filter="all" aria-pressed="true">
          All 25 Volumes
        </button>
        <button class="filter-btn" type="button" data-filter="FREE" aria-pressed="false">
          Free Online ({freeCount})
        </button>
        <button class="filter-btn" type="button" data-filter="BORROW" aria-pressed="false">
          Library Loan ({borrowCount})
        </button>
        <button class="filter-btn" type="button" data-filter="COMMERCIAL" aria-pressed="false">
          In Print ({commercialCount})
        </button>
        <button class="filter-btn" type="button" data-filter="ancients" aria-pressed="false">
          Ancients (Eras I–II)
        </button>
        <button class="filter-btn" type="button" data-filter="moderns" aria-pressed="false">
          Moderns (Eras III–V)
        </button>
      </div>

      <nav class="era-jump-bar" aria-label="Jump directly to era">
        <span class="jump-label">Jump to:</span>
        {
          eras.map(e => (
            <a href={`#era-folio-${e.num}`} class="jump-link">
              Era {e.numeral}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="era-folios">
      {
        eras.map(era => {
          const eraBooks = curatedBooks.filter(b => b.era === era.num);
          return (
            <section class="era-folio" id={`era-folio-${era.num}`} aria-labelledby={`heading-era-${era.num}`}>
              <header class="era-folio-header">
                <div class="era-eyebrow">
                  <span class="era-pill">ERA {era.numeral}</span>
                  <span class="era-years-tag">{era.years}</span>
                </div>
                <h3 id={`heading-era-${era.num}`} class="era-folio-title">
                  {era.name}
                </h3>
                <p class="era-folio-desc">{era.desc}</p>
              </header>

              <div class="books-grid">
                {eraBooks.map(b => (
                  <article
                    class="book-card"
                    id={`book-${b.id}`}
                    data-book-card
                    data-access={b.access}
                    data-era={b.era}
                  >
                    <!-- Simulated Miniature Cloth Cover Trigger -->
                    <div class="card-cover-wrapper">
                      <button
                        type="button"
                        class:list={['mini-cover', `tone-${b.tone}`]}
                        data-book-trigger={b.id}
                        aria-label={`Open folio for ${b.title} by ${b.author}`}
                      >
                        <div class="cover-inner-border">
                          <span class="cover-era-mark">ERA {b.eraRoman}</span>
                          <span class="cover-title-text">{b.title}</span>
                          <span class="cover-author-text">{b.author}</span>
                          <span class="cover-seal" aria-hidden="true">✦</span>
                        </div>
                      </button>
                    </div>

                    <div class="card-content">
                      <div class="card-top-row">
                        <span class="card-book-num">VOL. {String(curatedBooks.indexOf(b) + 1).padStart(2, '0')}</span>
                        <span class:list={['card-access-badge', `access-${b.access.toLowerCase()}`]}>
                          {b.access === 'FREE' ? 'FREE ONLINE' : b.access === 'BORROW' ? 'LIBRARY LOAN' : 'IN PRINT'}
                        </span>
                      </div>

                      <h4 class="card-title">
                        <button type="button" class="title-trigger-btn" data-book-trigger={b.id}>
                          {b.title}
                        </button>
                      </h4>
                      <p class="card-author">{b.author} <span class="card-date">({b.eraYears})</span></p>

                      <p class="card-note">“{b.note}”</p>

                      <div class="card-actions">
                        <a
                          href={b.url}
                          class="action-read-link"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {b.accessLabel} ↗
                        </a>
                        <button type="button" class="action-inspect-btn" data-book-trigger={b.id}>
                          Inspect Folio
                        </button>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          );
        })
      }

---
import Base from '../../../layouts/Base.astro';
import SpaceHead from '../../../components/SpaceHead.astro';
import Section from '../../../components/Section.astro';
import { books as booksContent } from '../../../lib/content';

interface BookItem {
  id: string;
  era: number;
  eraName: string;
  eraRoman: string;
  eraYears: string;
  author: string;
  title: string;
  note: string;
  access: 'FREE' | 'BORROW' | 'COMMERCIAL';
  accessLabel: string;
  url: string;
  heightClass: string;
  widthClass: string;
  tone: string;
}

const eras = [
  {
    numeral: 'I',
    num: 1,
    name: 'Antiquity',
    years: '800 BCE – 200 CE',
    desc: 'From the tragic heroism of archaic Greece to the austere self-discipline of imperial Rome.',
  },
  {
    numeral: 'II',
    num: 2,
    name: 'Middle Ages & Renaissance',
    years: '400 – 1600 CE',
    desc: 'Introspective faith, the wheel of fortune, cold political realism, and the birth of personal skepticism.',
  },
  {
    numeral: 'III',
    num: 3,
    name: 'Early Modernity & Enlightenment',
    years: '1630 – 1780 CE',
    desc: 'Methodological doubt, geometric pantheism, existential anxiety, and empirical common sense.',
  },
  {
    numeral: 'IV',
    num: 4,
    name: 'Idealism & The 19th Century',
    years: '1780 – 1900 CE',
    desc: 'The architecture of mind, historical dialectic, dark cosmic will, the leap of faith, and radical revaluation.',
  },
  {
    numeral: 'V',
    num: 5,
    name: 'Society, Language & Modernity',
    years: '1770 – 1955 CE',
    desc: 'The social fabric, revolutionary prose, Dasein thrown into time, and the logical boundaries of speech.',
  },
];

const curatedBooks: BookItem[] = [
  // Era I: Antiquity
  {
    id: 'homer-iliad',
    era: 1,
    eraName: 'Antiquity',
    eraRoman: 'I',
    eraYears: 'c. 750 BCE',

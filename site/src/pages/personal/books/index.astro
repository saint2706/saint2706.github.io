    author: 'Ludwig Wittgenstein',
    title: 'Philosophical Investigations',
    note: 'Words as tools in living language-games, showing the fly the way out of the bottle by assembling plain reminders.',
    access: 'BORROW',
    accessLabel: 'Borrow on Internet Archive',
    url: 'https://archive.org/details/philosophicalinv0000ludw',
    heightClass: 'h-tall',
    widthClass: 'w-regular',

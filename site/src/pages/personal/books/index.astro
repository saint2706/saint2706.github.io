    url: 'https://www.gutenberg.org/ebooks/2199',
    heightClass: 'h-tall',
    widthClass: 'w-regular',
    tone: 'terracotta',
  },
  {
    id: 'plato-works',
    era: 1,
    eraName: 'Antiquity',
    eraRoman: 'I',
    eraYears: 'c. 380 BCE',
    author: 'Plato',
    title: 'Complete Works',
    note: 'Philosophy as living street conversation: stubborn questions, irony, and Socrates daring the city to examine its soul.',
    access: 'COMMERCIAL',
    accessLabel: 'In print (Hackett)',

    eraRoman: 'II',
    eraYears: '397–400 CE',
    author: 'Augustine',
    title: 'Confessions',
    note: 'The invention of the modern inner self: memory, restless desire, bereavement, and the dizzying puzzle of time.',
    access: 'FREE',
    accessLabel: 'Free to read online',
    url: 'https://gutenberg.org/cache/epub/3296/pg3296-images.html',

    note: 'Standing on Mount Moriah with Abraham: the terrifying vertigo of faith when it suspends the universal moral code.',
    access: 'BORROW',
    accessLabel: 'Borrow on Internet Archive',
    url: 'https://archive.org/details/feartremblingdia0000skie_r6e3',
    heightClass: 'h-mid',

                <h3 id={`heading-era-${era.num}`} class="era-folio-title">
                  {era.name}
                </h3>
                <p class="era-folio-desc">{era.desc}</p>
              </header>

              <div class="books-grid">
                {eraBooks.map(b => (
                  <article
                    class="book-card"
                    id={`book-${b.id}`}
                    data-book-card
                    data-access={b.access}
                    data-era={b.era}
                  >
                    <!-- Real Book Cover Thumbnail Trigger -->
                    <div class="card-cover-wrapper">
                      <button
                        type="button"
                        class="real-cover-btn"
                        data-book-trigger={b.id}
                        aria-label={`Open folio for ${b.title} by ${b.author}`}
                      >
                        <img
                          src={b.cover}
                          alt={`Cover of ${b.title}`}
                          width="96"
                          height="144"
                          loading="lazy"
                          decoding="async"
                          class="card-cover-img"
                        />
                      </button>
                    </div>

                    <div class="card-content">
                      <div class="card-top-row">
                        <span class="card-book-num">VOL. {String(curatedBooks.indexOf(b) + 1).padStart(2, '0')}</span>
                        <span class:list={['card-access-badge', `access-${b.access.toLowerCase()}`]}>
                          {b.access === 'FREE' ? 'FREE ONLINE' : b.access === 'BORROW' ? 'LIBRARY LOAN' : 'IN PRINT'}
                        </span>
                      </div>

                      <h4 class="card-title">
                        <button type="button" class="title-trigger-btn" data-book-trigger={b.id}>
                          {b.title}
                        </button>
                      </h4>
                      <p class="card-author">{b.author} <span class="card-date">({b.eraYears})</span></p>

                      <p class="card-note">“{b.note}”</p>

                      <div class="card-actions">
                        <a
                          href={b.url}
                          class="action-read-link"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {b.accessLabel} ↗
                        </a>
                        <button type="button" class="action-inspect-btn" data-book-trigger={b.id}>
                          Inspect Cover Folio
                        </button>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          );
        })
      }
    </div>

    <p class="verification-note">
      Verified from personal records. All editions and open links checked on {booksContent.verifiedOn}.
    </p>
  </Section>

  <!-- Interactive Book Folio Pop-up Modal (Real Book Covers) -->
  <dialog id="book-modal" class="book-modal" aria-labelledby="modal-book-title">
    <div class="modal-window">
      <!-- Left Column: Real Authentic Book Cover Presentation -->
      <div class="modal-cover-column">
        <div class="modal-real-cover-jacket">
          <img
            data-modal-cover-img
            src={curatedBooks[0].cover}
            alt=""
            width="220"
            height="330"
            class="modal-cover-photo"
            loading="eager"
          />
          <span class="modal-cover-ribbon" aria-hidden="true" />
        </div>
      </div>

      <!-- Right Column: Curatorial Dossier & Access -->
      <div class="modal-info-column">
        <header class="modal-header">
          <div class="modal-eyebrow">
            <span class="modal-counter" data-modal-counter>VOLUME 01 OF 25</span>
            <span class="modal-pill" data-modal-access-pill>FREE ONLINE</span>
          </div>
          <p class="modal-era-label" data-modal-era>ERA I · ANTIQUITY</p>
          <h2 id="modal-book-title" class="modal-title" data-modal-title>{curatedBooks[0].title}</h2>
          <p class="modal-author" data-modal-author>{curatedBooks[0].author}</p>
          <p class="modal-publisher-line" data-modal-publisher>Edition imprint: PENGUIN</p>
        </header>

        <div class="modal-takeaway-block">
          <span class="takeaway-label">CURATORIAL REFLECTION</span>
          <p class="modal-note-text" data-modal-note>“{curatedBooks[0].note}”</p>
        </div>

        <div class="modal-access-block">
          <a
            class="modal-open-link"
            data-modal-link
            href={curatedBooks[0].url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Read Online Now ↗
          </a>
        </div>

        <div class="modal-controls">
          <div class="modal-step-btns">
            <button class="btn-modal-step" type="button" data-book-step="-1">‹ Prev Volume</button>
            <button class="btn-modal-step" type="button" data-book-step="1">Next Volume ›</button>
          </div>
          <button class="btn-modal-close" type="button" data-modal-close>Close [Esc]</button>
        </div>
      </div>
    </div>
  </dialog>

  {/* Client-side JSON data block */}
  <script type="application/json" id="books-data" is:inline set:html={JSON.stringify(curatedBooks).replaceAll('<', '\\u003c')} />
</Base>


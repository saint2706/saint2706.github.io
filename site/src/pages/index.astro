---
import Base from '../layouts/Base.astro';
import { profile, about } from '../lib/content';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.jobTitle,
  url: 'https://saint2706.github.io/',
  sameAs: profile.links.map(l => l.url),
  alumniOf: about.education.map(e => ({ '@type': 'CollegeOrUniversity', name: e.org })),
  knowsLanguage: profile.languages.map(l => l.name),
};
---

<Base title="Home" description={profile.summary} jsonLd={jsonLd}>
  <h1 class="headline">Data, technology and a bit of creativity, used to tell stories.</h1>
  <ul class="field" aria-label="Spaces">
    <li class="s1">
      <a class="spec" href="/work/">
        <span class="shape" aria-hidden="true"></span>
        <span class="label">01 Work <span class="tag">open</span></span>
        <span class="desc">Projects, roles and what I studied</span>
      </a>
    </li>
    <li class="s2">
      <a class="spec" href="/writing/">
        <span class="shape" aria-hidden="true"></span>
        <span class="label">02 Writing <span class="tag">read</span></span>
        <span class="desc">Essays and notes</span>
      </a>
    </li>
    <li class="s3">
      <a class="spec" href="/lab/">
        <span class="shape" aria-hidden="true"></span>
        <span class="label">03 Lab <span class="tag">some of this works</span></span>
        <span class="desc">Experiments</span>
      </a>
    </li>
  </ul>
  <p class="gateway">
    <a class="per" href="/personal/">Off the clock: art, books and films</a>
  </p>
</Base>

<style>
  :global(main) {
    padding: 0 var(--gutter) 96px;
  }
  .field {
    list-style: none;
    margin: 24px auto 0;
    padding: 0;
    max-width: 1100px;
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .spec {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .shape {
    display: block;
    background: var(--color-rule);
    width: 100%;
    transition: transform 0.35s var(--ease-out);
  }
  .s1 .shape {
    aspect-ratio: 1;
    border-radius: 50%;
    margin-top: 60px;
    background: var(--pro-accent);
  }
  .s2 .shape {
    aspect-ratio: 1 / 2;
    background: var(--color-ink);
  }
  .s3 .shape {
    aspect-ratio: 1;
    border-radius: 28px;
    background: transparent;
    border: 3px dashed var(--lab-accent);
    margin-top: 120px;
  }
  .label {
    display: block;
    margin-top: 16px;
    font-size: 1.125rem;
    font-weight: 500;
  }
  .tag {
    display: inline-block;
    margin-left: 8px;
    padding: 4px 12px;
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 0.8125rem;
  }
  .desc {
    display: block;
    color: var(--color-ink-2);
    font-size: 0.9375rem;
    margin-top: 4px;
  }
  /* Nudge only when motion is on. */
  html[data-motion='on'] .spec:hover .shape,
  html[data-motion='on'] .spec:focus-visible .shape {
    transform: translate(6px, -8px);
  }
  html[data-motion='on'] .field > li,
  html[data-motion='on'] .headline {
    animation: a1-rise 0.7s var(--ease-out) both;
  }
  html[data-motion='on'] .field > li:nth-child(2) {
    animation-delay: 90ms;
  }
  html[data-motion='on'] .field > li:nth-child(3) {
    animation-delay: 180ms;
  }
  html[data-motion='on'] .headline {
    animation-delay: 270ms;
  }
  .spec:hover .label,
  .spec:focus-visible .label {
    text-decoration: underline;
  }
  .headline {
    max-width: 820px;
    margin: 72px auto 0;
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    line-height: 1.2;
  }
  .gateway {
    max-width: 1100px;
    margin: 72px auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-rule);
  }
  /* The gateway is a strip of the personal room, so the change of space shows before the click. */
  .gateway a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 12px 24px;
    border-radius: 4px;
    background: var(--color-canvas);
    color: var(--color-ink);
    font: 1.25rem / 1.3 var(--font-display);
    text-decoration: none;
  }
  .gateway a::after {
    content: '→' / '';
    color: var(--color-accent);
    font-family: var(--font-body);
  }
  .gateway a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.2em;
  }
  /* Tablet: same three-up field, tighter offsets so the cards stay above the fold. */
  @media (max-width: 1024px) and (min-width: 721px) {
    .field {
      gap: 24px;
    }
    .s1 .shape {
      margin-top: 32px;
    }
    .s3 .shape {
      margin-top: 64px;
    }
    .headline {
      margin-top: 48px;
    }
  }
  @media (max-width: 720px) {
    :global(main) {
      padding: 0 24px 120px;
    }
    .field {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .s1 {
      grid-column: 1 / -1;
    }
    .s1 .shape {
      margin-top: 8px;
      max-width: 260px;
    }
    .s2 .shape {
      aspect-ratio: 9 / 10;
    }
    .s3 .shape {
      margin-top: 24px;
      aspect-ratio: 1;
    }
    .headline {
      margin-top: 40px;
      font-size: 1.375rem;
    }
    .gateway {
      margin-top: 48px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shape {
      transition: none;
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import SpaceHead from '../../components/SpaceHead.astro';
import Section from '../../components/Section.astro';
import NextLinks from '../../components/NextLinks.astro';
import { profile, about, isExpired } from '../../lib/content';

const sections = [
  { id: 'roles', title: 'Roles', items: about.roles },
  { id: 'studied', title: 'What I studied', items: about.education },
];
const validity = (expires: string | null) =>
  expires ? (isExpired(expires) ? ` · expired ${expires}` : ` · valid to ${expires}`) : '';
---

<Base title="About" description={profile.summary}>
  <SpaceHead title="About" lede={profile.summary}>
    <button class="btn" type="button" data-print data-needs-js hidden>Print or save as PDF</button>
    {/* A printed resume needs the contact details the site keeps on /contact/. */}
    <ul class="print-only plain">
      <li>{profile.email}</li>
      {profile.links.map(l => <li>{l.label}: {l.url}</li>)}
    </ul>
  </SpaceHead>
  {
    sections.map((s, i) => (
      <Section id={s.id} num={i + 1} title={s.title}>
        <ul class="rows">
          {s.items.map(e => (
            <li>
              <h3>
                {e.title}, {e.org}
              </h3>
              <span class="meta">
                {e.start} to {e.end}
              </span>
              <p>{e.summary}</p>
            </li>
          ))}
        </ul>
      </Section>
    ))
  }
  <Section id="skills" num={3} title="Skills">
    <ul class="rows">
      {
        about.skills.map(s => (
          <li>
            <h3>{s.group}</h3>
            <p>{s.items.join(', ')}</p>
          </li>
        ))
      }
    </ul>
  </Section>
  <Section id="certifications" num={4} title="Certifications">
    <ul class="rows">
      {
        about.certifications.map(c => (
          <li>
            <h3>{c.name}</h3>
            <span class="meta">
              {c.issuer}
              {c.date && ` · ${c.date}`}
              {validity(c.expires)}
            </span>
          </li>
        ))
      }
    </ul>
  </Section>
  <Section id="languages" num={5} title="Languages">
    <ul class="rows">
      {
        profile.languages.map(l => (
          <li>
            <h3>{l.name}</h3>
            <span class="meta">{l.level}</span>
          </li>
        ))
      }
    </ul>
  </Section>
  <NextLinks
    links={[
      { href: '/contact/', label: 'Contact' },
      { href: '/projects/', label: 'Projects' },
    ]}
  />
</Base>

<script>
  document.querySelector('[data-print]')!.addEventListener('click', () => print());
</script>

# Dependencies
node_modules/

# Build output
dist/

# Regenerated on every build by `prebuild` (scripts/generate-llms.js, scripts/generate-sitemap.js)
/public/llms.txt
/public/sitemap.xml

# Environment: commit the template, never real values
.env
.env.*
!.env.example

# Logs
*.log

# Test, lint and audit output (pnpm audit:lighthouse writes the Lighthouse reports)
coverage/
.eslintcache
/docs/audits/lighthouse-*.json

# Package manager policy (pnpm-only)
package-lock.json

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Local-only scratch and source material (never published)
/tmp/
/legacy_backup/
/art and books/

